APP_NAME="Laravel SI Praktikum"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta
LOG_CHANNEL=stack
LOG_LEVEL=debug
# [P04] SQLite paling sederhana. Untuk MySQL ubah DB_CONNECTION=mysql dan isi DB_HOST/PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel_si
# DB_USERNAME=root
# DB_PASSWORD=
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
# [P09] Email reset kata sandi disimpan di storage/logs/laravel.log pada mode praktikum.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@laravel-si.test"
MAIL_FROM_NAME="Laravel SI"
# [P12] API eksternal latihan tanpa token rahasia.
EXTERNAL_POSTS_BASE_URL=https://jsonplaceholder.typicode.com
